{
  "manifest_version": 3,
  "name": "QRAtt",
  "version": "3.0",
  "description": "Seçtiğin ders sekmesini arka planda izler, QR kod çıkınca yoklamaya numaranla katılır.",
  "permissions": ["storage", "tabs", "scripting", "notifications", "tabCapture", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icon16.png", "48": "icon48.png" } },
  "commands": {
    "watch-tab": { "suggested_key": { "default": "Alt+Shift+Q" }, "description": "Bu sekmeyi izlemeye başla" }
  }
}
